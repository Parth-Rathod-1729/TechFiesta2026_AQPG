import os
import json
from langchain_classic.chains.combine_documents import create_stuff_documents_chain
from langchain_classic.chains.retrieval import create_retrieval_chain
from langchain_core.prompts import ChatPromptTemplate

import LearningUtils

PDFname = input("Enter the PDF name(with .pdf extension): ")
targetPDFpath = os.path.join(".", "samplePDFs", PDFname)
print(f"Loading {targetPDFpath}...")
pdfVectorDB_path = os.path.join(".", "vectorDBs", f"{PDFname.split('.')[0]}_vecDB")

pdfVectorDB = LearningUtils.getVectorStoreOf(textPDFpath=targetPDFpath, databasePath=pdfVectorDB_path)
pdfRetriever = pdfVectorDB.as_retriever(
    search_type="similarity",
    search_kwargs={
        "k": 10
    }
)

qpGenLLM = LearningUtils.openAI_LLM7(temperature=0.1)
topicForQuiz = input("Enter your Topic for the quiz: ")
numberOfQuestionsForQuiz = int(input("Enter the number of questions: "))
invokingPromptDict = {
    "numberOfQuestions": numberOfQuestionsForQuiz,
    "input": topicForQuiz
}
baseInstruction = """
CRITICAL INSTRUCTIONS:
     - You are an expert educational content creator and a quiz generator specializing in Bloom's Taxonomy. You shall generate questions of a given topic from the given context in accordance with the 6 levels of bloom's taxonomy
         Which are:
         1. Remembering
         2. Understanding
         3. Applying
         4. Analyzing
         5. Evaluating
         6. Creating
         And If the context does not contain enough information for a specific level, leave the question field as blank ("")
     - If you feel that the topic is broad then generate question for various sub topics of the broad topic
     - You shall not ask for further assistance after the response is over
     - DO NOT add any conversational text before or after.
     - Output ONLY a valid JSON object in format given below. DO NOT add markdown like ```json and ```.
     - You shall generate {numberOfQuestions} questions about: {input}
     - If you include a question that relies on an example given in the context then make sure to include the entire example in the question. DO NOT make question without giving the example first if you do decide to use the example to generate the question.
"""

