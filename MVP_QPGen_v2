contextForInstruction = """
Context:
{context}
"""

questionType = int(input("""
Enter the type of question you would like to generate:
- MCQ (1)
- shortAnswer (2)
- longAnswer (3)
- True and False (4)
: """))

match questionType:
    case 1:
        questionType = "MCQ"
    case 2:
        questionType = "shortAnswer"
    case 3:
        questionType = "longAnswer"
    case 4:
        questionType = "booleanAnswer"
    case _:
        questionType = "shortAnswer"

qpGenPrompt = ChatPromptTemplate.from_template(
     baseInstruction + questionType_Instruction[questionType] + contextForInstruction
)

qpGenStuffChain = create_stuff_documents_chain(qpGenLLM, qpGenPrompt)
qpGenChain = create_retrieval_chain(pdfRetriever, qpGenStuffChain)
qpGenChainResponse = qpGenChain.invoke(invokingPromptDict)
print(f"{'==' * 10} Generated Response {'==' * 10}")
qpJSON = json.loads(qpGenChainResponse["answer"].replace("```json", "").replace("```", ""))
print(qpJSON)
